{
  "name": "contracts",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/contracts/src",
  "tags": ["scope:shared", "type:contracts"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{workspaceRoot}/dist/libs/contracts"],
      "options": { "outputPath": "dist/libs/contracts", "main": "libs/contracts/src/index.ts", "tsConfig": "libs/contracts/tsconfig.lib.json", "generatePackageJson": false }
    },
    "lint": { "executor": "nx:run-commands", "options": { "command": "eslint libs/contracts --max-warnings=0" } },
    "typecheck": { "executor": "nx:run-commands", "options": { "command": "tsc -p libs/contracts/tsconfig.lib.json --noEmit && tsc -p libs/contracts/tsconfig.spec.json --noEmit" } }
  }
}
