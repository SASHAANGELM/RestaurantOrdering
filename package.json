{
  "name": "restaurant-ordering",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": "24.22.0",
    "pnpm": "12.14.0"
  },
  "scripts": {
    "dev": "nx run-many -t serve -p frontend backend --parallel=2 --outputStyle=stream",
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t typecheck",
    "test": "nx run-many -t test",
    "build": "nx run-many -t build",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "e2e": "nx run frontend-e2e:e2e",
    "verify:native": "node tools/verify-native.cjs",
    "db:generate": "drizzle-kit generate --config apps/backend/drizzle.config.ts",
    "db:check": "drizzle-kit check --config apps/backend/drizzle.config.ts",
    "db:migrate": "nx build backend && node dist/apps/backend/database-cli.cjs migrate",
    "db:seed:small": "nx build backend && node dist/apps/backend/database-cli.cjs seed-small",
    "db:seed:large": "nx build backend && node dist/apps/backend/database-cli.cjs seed-large"
  },
  "dependencies": {
    "@angular/cdk": "22.2.3",
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/material": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/router": "22.2.3",
    "@ngrx/signals": "22.0.1",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.4",
    "express": "5.3.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@angular-devkit/core": "22.2.3",
    "@angular-devkit/schematics": "22.2.3",
    "@angular/build": "22.2.3",
    "@angular/cli": "22.2.3",
    "@angular/compiler-cli": "22.2.3",
    "@eslint/js": "10.0.1",
    "@nx/angular": "23.3.0",
    "@nx/esbuild": "23.3.0",
    "@nx/eslint": "23.3.0",
    "@nx/eslint-plugin": "23.3.0",
    "@nx/js": "23.3.0",
    "@nx/playwright": "23.3.0",
    "@nx/vitest": "23.3.0",
    "@playwright/test": "1.64.1",
    "@schematics/angular": "22.2.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "angular-eslint": "22.6.0",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "30.1.3",
    "nx": "23.3.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
